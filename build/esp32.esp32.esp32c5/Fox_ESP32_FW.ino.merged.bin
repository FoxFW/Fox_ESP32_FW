×#<33s?ÍÌL=š™™>␀␀ A␀␀€?␀␀úC33³>ÍÌÌ?␀␀€A␀␀°A␀␀€¿␀ª¸?p¥ì6␀␀€>«ªª>␀␀␀?;ª¸?␀␀€KBñS>U2l>£‹>·mÛ>š™?␀␀@@␀8v?O8v? Ã6<ª83␀r1?r1?Œ¾¿5L»13êİ5U³Š8a6;«ª*>␀␀␀@␀␀␀L`B¢ÊòIqÊòIñ`B¢␀␀␀3␀␀␀␀␀␀p␀␀À␀␀␀␀␀␀␀␀@H␀BpH␀BH␀B¬J␀B*H␀B.H␀B␀␀␀␀␀␀␀␀0H␀BPH␀BI␀BLI␀B*H␀B.H␀B
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<script>if (window.self !== window.top) document.documentElement.classList.add("embedded-frame");</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FoxFW Wallpaper Painter</title>
<style>
/* Scrollbars */
*{scrollbar-width:thin;scrollbar-color:#3a3a3a transparent}
*::-webkit-scrollbar{width:9px;height:9px}
*::-webkit-scrollbar-track{background-color:transparent}
*::-webkit-scrollbar-thumb{background-color:#3a3a3a;border-radius:20px;border:2px solid transparent;background-clip:padding-box}
*::-webkit-scrollbar-thumb:hover{background-color:var(--orange,var(--fox))}
*::-webkit-scrollbar-corner{background-color:transparent}

/* Floating back-to-top button - only shown when the page has a vertical scrollbar */
#backTop{position:fixed;bottom:24px;right:24px;width:52px;height:52px;background:var(--orange,var(--fox));color:#fff;font-size:1.5rem;line-height:1;border:none;border-radius:50%;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.45);z-index:1000;display:none;align-items:center;justify-content:center;transition:transform .15s ease,filter .15s ease}
#backTop.show{display:flex}
#backTop:hover{filter:brightness(1.12);transform:translateY(-2px)}
.embedded-frame #backTop{display:none!important}

  :root{
    --bg:#0c0d10;
    --panel:#151619;
    --panel-2:#1c1e22;
    --line:#2a2c31;
    --fox:#f89521;
    --fox-dim:#c97417;
    --text:#eceef1;
    --text-dim:#9a9ea6;
    --ok:#3ecf6e;
    --warn:#f2b705;
    --err:#e5484d;
    --mono: "JetBrains Mono", "SF Mono", Consolas, monospace;
    --sans: "Inter", -apple-system, "Segoe UI", sans-serif;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:var(--sans);
    min-height:100vh;
    display:flex; flex-direction:column; align-items:center;
    padding:32px 16px 64px;
  }
  .brand{ text-align:center; margin-bottom:6px; }
  .brand .fox{ font-size:34px; line-height:1; }
  .brand h1{
    font-family:var(--mono);
    font-size:15px; letter-spacing:.14em; text-transform:uppercase;
    margin:8px 0 2px; color:var(--text);
  }
  .brand .sub{
    font-family:var(--mono); font-size:11px; letter-spacing:.12em;
    color:var(--fox); text-transform:uppercase;
  }
  .backlink{
    margin-top:10px; font-family:var(--mono); font-size:11.5px;
  }
  .backlink a{ color:var(--text-dim); text-decoration:none; }
  .backlink a:hover{ color:var(--fox); }
  .embedded-frame .brand, .embedded-frame .backlink{ display:none; }
  .status-pill{
    display:inline-flex; align-items:center; gap:7px;
    padding:5px 11px; border-radius:20px; background:var(--panel-2);
    border:1px solid var(--line); color:var(--text-dim);
    font-family:var(--mono); font-size:11.5px;
  }
  .status-pill .dot{ width:7px; height:7px; border-radius:50%; background:var(--text-dim); }
  .status-pill.connected .dot{ background:var(--ok); box-shadow:0 0 6px var(--ok); }
  .status-pill.connected{ color:var(--ok); border-color:#1f4a30; }
  .status-pill.error .dot{ background:var(--err); }
  .status-pill.error{ color:var(--err); border-color:#4a1f21; }
  .status-pill.busy .dot{ background:var(--warn); animation:pulse 1.2s ease-in-out infinite; }
  .status-pill.busy{ color:var(--warn); border-color:#4a3a1f; }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:.35;} }

  .card{
    width:100%; max-width:820px; background:var(--panel);
    border:1px solid var(--line); border-radius:10px; padding:20px;
    margin-top:14px;
  }
  .card h2{
    font-size:12px; letter-spacing:.1em; text-transform:uppercase;
    color:var(--text-dim); margin:0 0 14px; font-family:var(--mono);
    display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;
  }
  .card h2.editor-head{
    display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:8px;
  }
  .card h2.editor-head > span:first-child{ justify-self:start; }
  .card h2.editor-head > .btn{ justify-self:center; }
  .card h2.editor-head > .status-pill{ justify-self:end; }
  .btn.small{ padding:6px 14px; font-size:11.5px; text-transform:none; letter-spacing:0; }

  .toolbar-row{ display:flex; align-items:center; gap:10px; margin-bottom:14px; }
  .toolbar{
    flex:1; min-width:0;
    display:flex; gap:6px; flex-wrap:wrap; align-items:center; justify-content:center;
    background:var(--panel-2); border:1px solid var(--line); border-radius:8px;
    padding:8px;
  }
  .tool-btn{
    width:36px; height:36px; display:flex; align-items:center; justify-content:center;
    background:transparent; border:1px solid transparent; border-radius:6px;
    color:var(--text-dim); cursor:pointer; font-size:16px;
  }
  .tool-btn:hover{ color:var(--text); background:var(--panel); }
  .tool-btn.active{ color:var(--fox); background:#2a1b06; border-color:var(--fox-dim); }
  .tool-sep{ width:1px; align-self:stretch; background:var(--line); margin:0 4px; }
  .tool-btn:disabled{ opacity:.35; cursor:default; }
  .tool-btn:disabled:hover{ background:transparent; color:var(--text-dim); }

  .canvas-wrap{
    display:flex; justify-content:center; padding:14px;
    background:repeating-conic-gradient(#1a1b1f 0% 25%, #161719 0% 50%) 0 0/16px 16px;
    border:1px solid var(--line); border-radius:8px; overflow:hidden;
  }
  #paintCanvas{
    image-rendering:pixelated; image-rendering:crisp-edges;
    cursor:crosshair; touch-action:none;
    box-shadow:0 0 0 1px #000, 0 0 24px rgba(0,0,0,.5);
    max-width:100%; height:auto; display:block;
  }

  .help-btn{
    position:relative; width:30px; height:30px; border-radius:50%;
    border:1px solid var(--fox-dim); background:var(--panel-2); color:var(--text-dim);
    display:flex; align-items:center; justify-content:center; font-size:14px;
    font-family:var(--mono); cursor:pointer; flex-shrink:0;
  }
  .help-btn:hover{ color:var(--fox); }
  .help-pop{
    position:absolute; top:130%; right:0; width:260px; z-index:20;
    background:var(--panel-2); border:1px solid var(--line); border-radius:8px;
    padding:12px 14px; font-size:11.5px; line-height:1.6; color:var(--text);
    text-transform:none; letter-spacing:0; font-family:var(--sans);
    opacity:0; visibility:hidden; transform:translateY(-4px);
    transition:opacity .12s, transform .12s, visibility .12s;
    box-shadow:0 8px 24px rgba(0,0,0,.4);
  }
  .help-pop strong{ color:var(--fox); }
  .help-btn:hover .help-pop, .help-btn.open .help-pop{
    opacity:1; visibility:visible; transform:translateY(0);
  }

  .chevron-btn{
    width:30px; height:30px; border-radius:50%;
    border:1px solid var(--fox-dim); background:var(--panel-2); color:var(--text-dim);
    display:flex; align-items:center; justify-content:center; font-size:14px;
    cursor:pointer; flex-shrink:0; transition:transform .15s;
  }
  .chevron-btn:hover{ color:var(--fox); }
  .chevron-btn.open{ transform:rotate(180deg); }

  .row{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
  .row + .row{ margin-top:12px; }
  .btn{
    font-family:var(--mono); font-size:12.5px; letter-spacing:.02em;
    padding:10px 16px; border-radius:7px; border:1px solid var(--line);
    background:var(--panel-2); color:var(--text); cursor:pointer;
  }
  .btn:hover:not(:disabled){ border-color:var(--fox-dim); color:var(--fox); }
  .btn:disabled{ opacity:.4; cursor:default; }
  .btn.primary{ background:var(--fox); border-color:var(--fox); color:#1a0f00; font-weight:700; }
  .btn.primary:hover:not(:disabled){ background:var(--fox-dim); color:#fff; }
  .btn.danger{ background:transparent; border-color:#4a1f21; color:var(--err); }
  .btn.danger:hover:not(:disabled){ background:#2a1013; }
  .btn.full{ flex:1; text-align:center; }

  /* Always-visible orange border; the label itself only lights up orange
     on hover. Disabled state keeps the border lit and brightens the text
     instead of the usual uniform opacity dim, so it stays readable. */
  .btn.accent{ border-color:var(--fox-dim); }
  .btn.accent:hover:not(:disabled){ color:var(--fox); }
  .btn.accent:disabled{ opacity:1; border-color:var(--fox-dim); color:#d8d9db; cursor:default; }

  /* Save to SD Card is a danger button underneath, but while it's actually
     usable (device connected) it should read as fully "ready to go" - the
     same solid lit-orange fill as the primary Download button - not just
     a dark tint. Disabled/no-device keeps the muted outline-only look. */
  .btn.danger.accent:not(:disabled){
    background:var(--fox); border-color:var(--fox); color:#1a0f00; font-weight:700;
  }
  .btn.danger.accent:hover:not(:disabled){ background:var(--fox-dim); border-color:var(--fox-dim); color:#fff; }
  .btn.danger.accent:disabled{ background:transparent; }

  .divider{ height:1px; background:var(--line); margin:16px 0; }

  .switch-row{ display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .switch-row .label{ font-size:13px; }
  .switch-row .hint{ font-size:11px; color:var(--text-dim); margin-top:2px; }
  .field-row .label{ font-size:13px; color:var(--text); }
  .text-input{
    width:100%; box-sizing:border-box; background:var(--panel-2); border:1px solid var(--line);
    color:var(--text); font-family:var(--mono); font-size:13px; padding:8px 10px; border-radius:6px;
    outline:none;
  }
  .text-input:focus{ border-color:var(--fox); }
  .switch{ position:relative; width:44px; height:24px; flex-shrink:0; }
  .switch input{ opacity:0; width:0; height:0; }
  .slider{
    position:absolute; inset:0; background:var(--panel-2); border:1px solid var(--fox-dim);
    border-radius:24px; cursor:pointer; transition:.15s;
  }
  .slider:before{
    content:""; position:absolute; width:16px; height:16px; left:3px; top:3px;
    background:var(--text-dim); border-radius:50%; transition:.15s;
  }
  .switch input:checked + .slider{ background:var(--ok); border-color:var(--ok); box-shadow:0 0 6px var(--ok); }
  .switch input:checked + .slider:before{ background:#f2fff6; transform:translateX(20px); }
  .switch input:disabled + .slider{ opacity:.4; cursor:default; }

  .box{
    border-radius:8px; padding:12px 14px; font-size:12.5px; line-height:1.6;
    border:1px solid var(--line); background:var(--panel-2); margin-top:12px;
  }
  .box.warn{ border-color:#4a3a1f; background:#241c0c; color:#f2c96a; }
  .box.info{ border-color:#1f3a4a; background:#0c1c24; color:#8fc7e0; }

  #consoleCard .console{
    background:#000; border:1px solid var(--line); border-radius:6px;
    padding:10px 12px; font-family:var(--mono); font-size:11.5px; line-height:1.6;
    max-height:200px; overflow-y:auto; white-space:pre-wrap; word-break:break-word;
  }
  #consoleCard .console .e{ color:var(--err); }
  #consoleCard .console .ok{ color:var(--ok); }
  #consoleCard .console .w{ color:var(--warn); }

  .modal-backdrop{
    position:fixed; inset:0; background:rgba(0,0,0,.6); display:none;
    align-items:center; justify-content:center; z-index:50; padding:16px;
  }
  .modal-backdrop.show{ display:flex; }
  .modal{
    width:100%; max-width:420px; background:var(--panel); border:1px solid #4a1f21;
    border-radius:10px; padding:22px;
  }
  .modal h3{ margin:0 0 10px; color:var(--err); font-size:15px; }
  .modal p{ font-size:13px; line-height:1.6; color:var(--text); }
  .modal .row{ margin-top:18px; }

  .footer{
    margin-top:26px; font-family:var(--mono); font-size:11px; color:var(--text-dim);
    text-align:center; max-width:620px; line-height:1.8;
  }
  .footer a{ color:var(--fox-dim); text-decoration:none; }
  .footer a:hover{ color:var(--fox); }
</style>
</head>
<body>

<div class="brand">
  <div class="fox">ğŸ¦Š</div>
  <h1>FoxFW Wallpaper Painter</h1>
  <div class="sub">128 Ã— 64 Â· .xbm</div>
</div>

<div class="card">
  <h2 class="editor-head">
    <span>Editor</span>
    <button class="btn small accent" id="connectToggleBtn">&#128268; Connect Flipper</button>
    <span class="status-pill" id="devicePill"><span class="dot"></span><span id="devicePillText">No device connected</span></span>
  </h2>

  <div class="box" id="serialUnsupportedBox" style="display:none;">
    This browser doesn't support Web Serial, so device features aren't available here.
    Use Chrome or Edge on desktop â€” you can still download your wallpaper below
    and copy it into the <code>wallpapers</code> folder on the SD card by hand.
  </div>

  <div class="box warn" id="versionWarnBox" style="display:none;"></div>

  <div class="toolbar-row">
    <div class="toolbar">
      <button class="tool-btn active" id="toolPencil" title="Pencil">&#9998;</button>
      <button class="tool-btn" id="toolEraser" title="Eraser">&#9083;</button>
      <button class="tool-btn" id="toolLine" title="Line">&#9585;</button>
      <button class="tool-btn" id="toolFill" title="Fill bucket">&#128167;</button>
      <div class="tool-sep"></div>
      <button class="tool-btn" id="toolImport" title="Import image or .xbm">&#128247;</button>
      <button class="tool-btn" id="toolImportCurrent" title="Import current wallpaper from connected Flipper (requires FoxFW v2.0.5+)" disabled>&#128229;</button>
      <div class="tool-sep"></div>
      <button class="tool-btn" id="toolUndo" title="Undo" disabled>&#8630;</button>
      <button class="tool-btn" id="toolRedo" title="Redo" disabled>&#8631;</button>
      <div class="tool-sep"></div>
      <button class="tool-btn" id="toolZoomOut" title="Zoom out">&minus;</button>
      <button class="tool-btn" id="toolZoomIn" title="Zoom in">&plus;</button>
      <div class="tool-sep"></div>
      <button class="tool-btn" id="toolClear" title="Clear drawing">&#128465;</button>
      <input type="file" id="importFileInput" accept=".png,.jpg,.jpeg,.gif,.bmp,.webp,.xbm" style="display:none;">
    </div>
    <div class="help-btn" id="lockHelpBtn" tabindex="0">
      ?
      <div class="help-pop">
        The gray strip along the edges is locked on every FoxFW wallpaper â€” the device draws
        its live status icons over that area, so anything painted there is never visible on
        the actual screen. You can only draw in the open white area, same as every FoxFW
        wallpaper ships with.
      </div>
    </div>
  </div>

  <div class="canvas-wrap">
    <canvas id="paintCanvas" width="768" height="384"></canvas>
  </div>

  <div class="switch-row" style="margin-top:14px;">
    <div>
      <div class="label">Show Live on Device</div>
      <div class="hint">Not available yet when connected through FoxLAB's WiFi relay - drawing and saving below both work fully.</div>
    </div>
    <label class="switch">
      <input type="checkbox" id="liveToggle" disabled>
      <span class="slider"></span>
    </label>
  </div>
</div>

<div class="card">
  <h2>
    <span>Saving</span>
    <div class="help-btn" id="saveHelpBtn" tabindex="0">
      ?
      <div class="help-pop" style="right:-6px;">
        <strong>Download</strong><br>
        Works with no Flipper connected â€” saves an <code>.xbm</code> file to your computer.
        Copy it into the <code>wallpapers</code> folder on the root of your SD card
        (path: <code>/ext/wallpapers/</code>), then pick it under Fox Settings &rarr;
        Custom Wallpaper on the device.
        <br><br>
        <strong>Save to Flipper SD Card</strong><br>
        Saves into the <code>wallpapers</code> folder on the connected Flipper's SD card and
        sets it as the active Custom Wallpaper. Existing wallpapers are kept â€” if the name is
        already taken, a number is added automatically. Requires a connected device.
      </div>
    </div>
  </h2>

  <div class="field-row" style="margin-bottom:10px;">
    <label class="label" for="wallpaperNameInput" style="display:block;margin-bottom:4px;">Wallpaper Name</label>
    <input type="text" id="wallpaperNameInput" class="text-input" value="MyWallpaper" maxlength="40" autocomplete="off">
  </div>

  <div class="row">
    <button class="btn primary full" id="downloadBtn">&#8681; Download</button>
    <button class="btn danger accent full" id="saveToSdBtn" disabled>&#9888; Save to Flipper SD Card</button>
  </div>
</div>

<div class="card" id="consoleCard">
  <h2>
    <span>Device Log</span>
    <button class="chevron-btn" id="logToggleBtn" title="Show / hide log">&#9660;</button>
  </h2>
  <div class="console" id="consoleEl" style="display:none;"></div>
</div>

<div class="footer">
  <div>
    Prefer working offline in MS Paint instead? The original
    <a href="https://github.com/FoxFW/FoxFW-Wallpaper-Converter" target="_blank" rel="noopener">FoxFW Wallpaper Converter</a>
    tool still works the same as always â€” this page is just a faster, in-browser alternative
    with live device preview built in.
  </div>
  <div style="margin-top:10px;">
    Made something you'd like to share? Post it in <code>#custom-wallpapers</code> on
    <a href="https://discord.gg/gZDqCwSGrQ" target="_blank" rel="noopener">our Discord</a>.
  </div>
  <div style="margin-top:10px;">
    Questions or issues? <a href="mailto:foxcustomfirmware@gmail.com">foxcustomfirmware@gmail.com</a>
    &nbsp;or&nbsp; <a href="https://discord.gg/gZDqCwSGrQ" target="_blank" rel="noopener">Discord</a>
  </div>
</div>

<div class="modal-backdrop" id="sdModalBackdrop">
  <div class="modal">
    <h3>&#9888; Save to Flipper SD Card?</h3>
    <p>
      This saves your current drawing into the <code>wallpapers</code> folder on this Flipper's
      SD card and sets it as the <strong>active</strong> Custom Wallpaper, turning Custom
      Wallpaper on if it's currently off. Existing wallpapers are kept â€” if the name is already
      taken, a number is added automatically.
    </p>
    <div class="row">
      <button class="btn full" id="sdModalCancel">Cancel</button>
      <button class="btn danger full" id="sdModalConfirm">Save</button>
    </div>
  </div>
</div>

<!-- This FoxLAB-embedded copy of the Wallpaper Painter never loads
     protobufjs or assets/js/flipper-rpc.js (the old Web-Serial RPC
     transport) - FoxLAB's AP has no internet for that CDN script anyway,
     and every real connection here goes through the FLPR WebSocket relay
     the Lab page already has open (window.foxfwLabFlipper), never Web
     Serial. See the "Flipper connection" comment further down. -->
<script>
