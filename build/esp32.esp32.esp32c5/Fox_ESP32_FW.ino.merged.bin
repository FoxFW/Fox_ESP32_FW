              <option value="300">0.3s</option>
              <option value="400">0.4s</option>
              <option value="500">0.5s</option>
              <option value="600">0.6s</option>
              <option value="700">0.7s</option>
              <option value="800">0.8s</option>
              <option value="900">0.9s</option>
              <option value="1000">1s</option>
            </select>
          </div>
          <div class="set-field">
            <span>Color Step</span>
            <select id="setRgbStep"><option value="1">1</option><option value="2">2</option><option value="3">3</option></select>
          </div>
          <div class="set-field">
            <span>Saturation <span class="set-val" id="setRgbSaturationVal"></span></span>
            <input type="range" id="setRgbSaturation" min="1" max="255" step="1">
          </div>
          <div class="set-field">
            <span>Wave Width</span>
            <select id="setRgbWaveWide"><option value="30">1</option><option value="40">2</option><option value="50">3</option></select>
          </div>
        </div>
        <p style="color:#999;font-size:.85em;margin:10px 0 0">
          Only relevant on Flippers with the RGB backlight hardware mod installed.
        </p>
      </div>
      <div class="card">
        <h3>Locale &amp; Input</h3>
        <div class="set-grid">
          <div class="set-field">
            <span>Time Format</span>
            <select id="setTimeFmt"><option value="0">24-hour</option><option value="1">12-hour</option></select>
          </div>
          <div class="set-field">
            <span>Date Format</span>
            <select id="setDateFmt"><option value="0">Day/Month/Year</option><option value="1">Month/Day/Year</option><option value="2">Year/Month/Day</option></select>
          </div>
          <div class="set-field">
            <span>Units</span>
            <select id="setUnits"><option value="0">Metric</option><option value="1">Imperial</option></select>
          </div>
          <div class="set-field">
            <span>Hand Orientation</span>
            <select id="setHand"><option value="0">Right-handed</option><option value="1">Left-handed</option></select>
          </div>
        </div>
      </div>
      <div class="card">
        <h3>System</h3>
        <div class="set-grid">
          <div class="set-field">
            <span>Sleep Method</span>
            <select id="setSleepMethod"><option value="0">Default</option><option value="1">Legacy</option></select>
          </div>
          <div class="set-field">
            <span>File Naming</span>
            <select id="setFileNaming"><option value="0">Default</option><option value="1">Detailed</option></select>
          </div>
        </div>
      </div>
      <div class="card">
        <h3>Notifications</h3>
        <div class="set-grid">
          <div class="set-field">
            <span>Buttons Vibro</span>
            <select id="setVibroLevel">
              <option value="0">Off</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
              <option value="6">6</option>
              <option value="7">7</option>
              <option value="8">8</option>
              <option value="9">9</option>
            </select>
          </div>
          <div class="set-field">
            <span>Vibro Trigger</span>
            <select id="setVibroTrigger"><option value="0">Press</option><option value="1">Release</option><option value="2">Both</option></select>
          </div>
        </div>
      </div>
      <div class="card">
        <h3>Night Shift</h3>
        <div class="set-grid">
          <div class="set-field">
            <span>Night Shift</span>
            <select id="setNightShift">
              <option value="0">Off</option>
              <option value="1">-10%</option>
              <option value="2">-20%</option>
              <option value="3">-30%</option>
              <option value="4">-40%</option>
              <option value="5">-50%</option>
              <option value="6">-60%</option>
            </select>
          </div>
          <div class="set-field">
            <span>Start</span>
            <input type="time" id="setNightShiftStart">
          </div>
          <div class="set-field">
            <span>End</span>
            <input type="time" id="setNightShiftEnd">
          </div>
        </div>
        <button class="bsm pri" id="applyNightShiftBtn" style="margin-top:16px">Apply</button>
      </div>
      <div class="card">
        <h3>Fox Alarm Clock</h3>
        <div class="set-grid">
          <div class="set-field">
            <span>Keep Backlight On</span>
            <select id="setAlarmBacklight"><option value="0">Off</option><option value="1">On</option></select>
          </div>
          <div class="set-field">
            <span>Alarm Beep</span>
            <select id="setAlarmBeep"><option value="1">On</option><option value="0">Off</option></select>
          </div>
          <div class="set-field">
            <span>Alarm Vibrate</span>
            <select id="setAlarmVibrate"><option value="1">On</option><option value="0">Off</option></select>
          </div>
        </div>
        <h4 style="margin:20px 0 10px;font-size:.8rem;color:#999;text-transform:uppercase;letter-spacing:.04em">Alarms</h4>
        <div id="alarmListBody"></div>
        <button class="bsm pri" id="addAlarmBtn" style="margin-top:12px">+ Add Alarm</button>
        <div id="alarmEditor" style="display:none;margin-top:16px;padding:14px;background:var(--dark);border:1px solid var(--border);border-radius:8px">
          <div class="set-grid">
            <div class="set-field">
              <span>Time</span>
              <input type="time" id="alarmEditTime">
            </div>
            <div class="set-field">
              <span>Active</span>
              <select id="alarmEditActive"><option value="1">On</option><option value="0">Off</option></select>
            </div>
            <div class="set-field">
              <span>Repeat</span>
              <select id="alarmEditRecurring"><option value="1">Weekly on selected days</option><option value="0">Once</option></select>
            </div>
          </div>
          <div id="alarmEditDays" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:12px"></div>
          <div style="display:flex;gap:10px;margin-top:16px">
            <button class="bsm pri" id="alarmEditSaveBtn">Add Alarm</button>
            <button class="bsm" id="alarmEditCancelBtn">Cancel</button>
          </div>
        </div>
      </div>
      <div class="card">
        <h3>Power</h3>
        <div class="set-grid">
          <div class="set-field">
            <span>Auto PowerOff</span>
            <select id="setAutoPoweroff">
              <option value="0">Off</option>
              <option value="1">5 min</option>
              <option value="2">10 min</option>
              <option value="3">15 min</option>
              <option value="4">30 min</option>
              <option value="5">45 min</option>
              <option value="6">60 min</option>
              <option value="7">90 min</option>
            </select>
          </div>
          <div class="set-field">
            <span>Limit Charge</span>
            <select id="setLimitCharge">
              <option value="0">Off</option>
              <option value="1">90%</option>
              <option value="2">85%</option>
              <option value="3">80%</option>
              <option value="4">75%</option>
              <option value="5">70%</option>
            </select>
          </div>
        </div>
      </div>
      <div class="card">
        <h3>Bluetooth</h3>
        <div class="set-grid">
          <div class="set-field">
            <span>Bluetooth</span>
            <select id="setBtEnabled"><option value="1">On</option><option value="0">Off</option></select>
          </div>
        </div>
      </div>
      <div class="notice warn" id="settingsUnavailableNotice">
        Couldn't read the current settings from the device - the controls above may not match
        what's actually set. Reopen this tab to retry, or double-check before saving.
      </div>`;

    try {
      const dt = await flipper.getDateTime();
      if (dt) $("deviceClockTxt").textContent = `${String(dt.day).padStart(2, "0")}/${String(dt.month).padStart(2, "0")}/${dt.year} ${String(dt.hour).padStart(2, "0")}:${String(dt.minute).padStart(2, "0")}:${String(dt.second).padStart(2, "0")}`;
    } catch (e) { $("deviceClockTxt").textContent = "unavailable"; }
    $("syncClockBtn").addEventListener("click", async () => {
      const now = new Date();
      try {
        await flipper.setDateTime({
          hour: now.getHours(), minute: now.getMinutes(), second: now.getSeconds(),
          day: now.getDate(), month: now.getMonth() + 1, year: now.getFullYear(),
          weekday: now.getDay() === 0 ? 7 : now.getDay(),
        });
        logLine("Clock synced.", "ok");
        renderFlipperSettings();
      } catch (e) { logLine("Clock sync failed: " + e.message, "e"); }
    });
    $("rebootOsBtn").addEventListener("click", () => { if (confirm("Reboot the Flipper?")) flipper.reboot(0).catch(e => logLine(e.message, "e")); });
    $("rebootDfuBtn").addEventListener("click", () => { if (confirm("Reboot into DFU mode? You'll need to reboot again manually to leave it.")) flipper.reboot(1).catch(e => logLine(e.message, "e")); });

    // â”€â”€ Settings: notification / locale / menu theme (task #54) â”€â”€â”€â”€â”€â”€â”€â”€
    const rangeIds = ["setContrast", "setBacklight", "setLed", "setVolume"];
    rangeIds.forEach((id) => {
      $(id).addEventListener("input", () => {
        const suffix = id === "setContrast" ? "" : "%";
        $(id + "Val").textContent = $(id).value + suffix;
      });
    });
    $("setRgbSaturation").addEventListener("input", () => {
      $("setRgbSaturationVal").textContent = $("setRgbSaturation").value;
    });
    try {
      const s = await flipper.getSettings();
      if (!s) throw new Error("no settings payload");
      $("setContrast").value = s.contrast;
      $("setBacklight").value = s.backlightPct;
      $("setLed").value = s.ledPct;
      $("setVolume").value = s.volumePct;
      rangeIds.forEach((id) => $(id).dispatchEvent(new Event("input")));
      $("setDelay").value = String(s.delayMs);
      $("setVibro").value = s.vibro ? "1" : "0";
      $("setInversion").value = s.inversion ? "1" : "0";
      $("setTimeFmt").value = String(s.timeFormat);
      $("setDateFmt").value = String(s.dateFormat);
      $("setUnits").value = String(s.units);
      $("setHand").value = String(s.handOrient);
      $("setTheme").value = String(s.theme);

      // â”€â”€ Fox Desktop display (task #75/#82) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      $("setBatteryView").value = String(s.batteryView);
      $("setShowClock").value = s.showClock ? "1" : "0";
      $("setMidnightFmt").value = s.midnightFormat ? "1" : "0";
      $("setWifiIcon").value = s.wifiIconHidden ? "1" : "0";
      $("setStatusbarIcons").value = s.statusbarIcons ? "1" : "0";
      $("setShellColor").value = String(s.shellColorIdx);

      // â”€â”€ Fox Alarm Clock globals â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      $("setAlarmBacklight").value = s.alarmKeepBacklight ? "1" : "0";
      $("setAlarmBeep").value = s.alarmBeep ? "1" : "0";
      $("setAlarmVibrate").value = s.alarmVibrate ? "1" : "0";

      // â”€â”€ Night Shift - minutes-since-midnight <-> "HH:MM" â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      const minToTime = (m) =>
        `${String(Math.floor(m / 60) % 24).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
      $("setNightShift").value = String(s.nightShiftIdx);
      $("setNightShiftStart").value = minToTime(s.nightShiftStartMin);
      $("setNightShiftEnd").value = minToTime(s.nightShiftEndMin);

      // â”€â”€ RGB Backlight â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      $("setRgbInstalled").value = s.rgbInstalled ? "1" : "0";
      $("setRgbWhiteMode").value = s.rgbWhiteMode ? "1" : "0";
      $("setRgbEffect").value = String(s.rgbEffect);
      $("setRgbSpeed").value = String(s.rgbSpeedMs);
      $("setRgbStep").value = String(s.rgbStep);
      $("setRgbSaturation").value = String(s.rgbSaturation);
      $("setRgbSaturationVal").textContent = String(s.rgbSaturation);
      $("setRgbWaveWide").value = String(s.rgbWaveWide);
      // LED color selects are populated from the device's own live color
      // table (getRgbColors()) rather than a hardcoded list here, so this
      // page can't drift out of sync with the firmware's color set.
      try {
        const colors = await flipper.getRgbColors();
        ["setRgbLed1", "setRgbLed2", "setRgbLed3"].forEach((id) => {
          $(id).innerHTML = colors.map((name, idx) => `<option value="${idx}">${name}</option>`).join("");
        });
        $("setRgbLed1").value = String(s.rgbLed1);
        $("setRgbLed2").value = String(s.rgbLed2);
        $("setRgbLed3").value = String(s.rgbLed3);
      } catch (e) {
        // Leave the LED selects empty - the rest of the RGB card (and its
        // Apply button) still works fine without the color name list.
      }

      // â”€â”€ Power â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      $("setAutoPoweroff").value = String(s.autoPoweroffIdx);
      $("setLimitCharge").value = String(s.limitChargeIdx);

      // â”€â”€ Bluetooth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      $("setBtEnabled").value = s.btEnabled ? "1" : "0";

      // â”€â”€ System â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      $("setSleepMethod").value = String(s.sleepMethod);
      $("setFileNaming").value = String(s.fileNaming);
      $("setDeviceName").value = s.deviceName || "";

      // â”€â”€ Input â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      $("setVibroLevel").value = String(s.vibroLevelIdx);
      $("setVibroTrigger").value = String(s.vibroTriggerIdx);
    } catch (e) {
      $("settingsUnavailableNotice").classList.add("show");
    }

    // â”€â”€ Security & Privacy (task #93) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Separate GET from the big one above - see getSecuritySettings()'s own
    // comment for why.
    function updatePinUi(pinIsSet) {
      $("pinLockStatus").textContent = pinIsSet
        ? "A PIN is currently set on this device."
        : "No PIN is currently set on this device.";
      $("setPinBtn").style.display = pinIsSet ? "none" : "";
      $("changePinBtn").style.display = pinIsSet ? "" : "none";
      $("removePinBtn").style.display = pinIsSet ? "" : "none";
      $("pinSetFields").style.display = "";
      $("pinCurrentField").style.display = pinIsSet ? "" : "none";
      $("setPinNew").value = "";
      $("setPinConfirm").value = "";
      $("setPinCurrent").value = "";
    }
    function collectSecurityPayload() {
      return {
        maxAttemptsIdx: Number($("setMaxAttempts").value),
        exceedAction: Number($("setOnExceed").value),
        onLockEnabled: $("setOnLockEnabled").value === "1",
        disconnectBle: $("setDisconnectBle").value === "1",
        disconnectGpio: $("setDisconnectGpio").value === "1",
        usbLevel: Number($("setUsbLevel").value),
        showTime: $("setLockShowTime").value === "1",
        showSeconds: $("setLockShowSeconds").value === "1",
        showDate: $("setLockShowDate").value === "1",
        showStatusbar: $("setLockShowStatusbar").value === "1",
        unlockPrompt: $("setLockUnlockPrompt").value === "1",
        poweroffLocked: $("setPoweroffLocked").value === "1",
        autoLockIdx: Number($("setAutoLock").value),
        usbInhibit: $("setUsbNoAutoLock").value === "1",
      };
    }
    function pinErrorMessage(e) {
      const map = {
        WRONGPIN: "Current PIN is incorrect.",
        AUTHREQUIRED: "Enter the current PIN first.",
        NOTSET: "No PIN is currently set.",
        INVALID: "PIN must be 1-10 digits.",
      };
      return map[e.message] || e.message;
    }
    let lastOnExceedValue = "0";
    try {
      const sec = await flipper.getSecuritySettings();
      if (!sec) throw new Error("no security settings payload");
      $("setMaxAttempts").value = String(sec.maxAttemptsIdx);
      $("setOnExceed").value = sec.exceedAction ? "1" : "0";
      $("setPoweroffLocked").value = sec.poweroffLocked ? "1" : "0";
      $("setAutoLock").value = String(sec.autoLockIdx);
      $("setUsbNoAutoLock").value = sec.usbInhibit ? "1" : "0";
      $("setOnLockEnabled").value = sec.onLockEnabled ? "1" : "0";
      $("setDisconnectBle").value = sec.disconnectBle ? "1" : "0";
      $("setDisconnectGpio").value = sec.disconnectGpio ? "1" : "0";
      $("setUsbLevel").value = String(sec.usbLevel);
      $("setLockShowTime").value = sec.showTime ? "1" : "0";
      $("setLockShowSeconds").value = sec.showSeconds ? "1" : "0";
      $("setLockShowDate").value = sec.showDate ? "1" : "0";
      $("setLockShowStatusbar").value = sec.showStatusbar ? "1" : "0";
      $("setLockUnlockPrompt").value = sec.unlockPrompt ? "1" : "0";
      updatePinUi(sec.pinIsSet);
      lastOnExceedValue = $("setOnExceed").value;
    } catch (e) {
      $("settingsUnavailableNotice").classList.add("show");
    }

    const PIN_PRIVACY_WARNING =
      'PINs and the settings below travel as plain text over this FoxLAB WiFi ' +
      'connection (the shared password shown on the Launcher screen) - anyone else ' +
      'on that network while you\'re using this page could see them. "On Exceed" can ' +
      'be set to wipe the SD card after too many wrong PIN attempts - double-check ' +
      'before turning that on.';
    $("setPinBtn").addEventListener("click", async () => {
      const newPin = $("setPinNew").value;
      const confirmPin = $("setPinConfirm").value;
      if (!/^[0-9]{1,10}$/.test(newPin)) { logLine("PIN must be 1-10 digits.", "e"); return; }
      if (newPin !== confirmPin) { logLine("PINs don't match.", "e"); return; }
      if (!confirm(PIN_PRIVACY_WARNING + "\n\nSet this PIN on the Flipper?")) return;
      try {
        await flipper.setPin("", newPin);
        logLine("PIN set.", "ok");
        renderFlipperSettings();
      } catch (e) { logLine("Set PIN failed: " + pinErrorMessage(e), "e"); }
    });
    $("changePinBtn").addEventListener("click", async () => {
      const currentPin = $("setPinCurrent").value;
      const newPin = $("setPinNew").value;
      const confirmPin = $("setPinConfirm").value;
      if (!currentPin) { logLine("Enter the current PIN first.", "e"); return; }
      if (!/^[0-9]{1,10}$/.test(newPin)) { logLine("PIN must be 1-10 digits.", "e"); return; }
      if (newPin !== confirmPin) { logLine("PINs don't match.", "e"); return; }
      if (!confirm(PIN_PRIVACY_WARNING + "\n\nChange the PIN on the Flipper?")) return;
      try {
        await flipper.setPin(currentPin, newPin);
        logLine("PIN changed.", "ok");
        renderFlipperSettings();
      } catch (e) { logLine("Change PIN failed: " + pinErrorMessage(e), "e"); }
    });
    $("removePinBtn").addEventListener("click", async () => {
      const currentPin = $("setPinCurrent").value;
      if (!currentPin) { logLine("Enter the current PIN first.", "e"); return; }
      if (!confirm(PIN_PRIVACY_WARNING + "\n\nRemove the PIN from the Flipper? Anyone with physical access will be able to unlock it.")) return;
      try {
        await flipper.clearPin(currentPin);
        logLine("PIN removed.", "ok");
        renderFlipperSettings();
      } catch (e) { logLine("Remove PIN failed: " + pinErrorMessage(e), "e"); }
    });

    // Pure select/range settings save themselves on change instead of
    // needing their own Apply button (task #86) - autoSave() wires that
    // up generically; a "Saved!" pill (see showSavedPill() above) is the
    // only feedback on success. Only Device Name (text entry), the PIN
    // actions above (their own explicit buttons - a save here is
    // security-sensitive enough to want a deliberate click either way),
    // Night Shift (real time-of-day entry, not just picking an option),
    // and the alarm editor below (multi-field, its own explicit Save)
    // keep an explicit action instead.
    function autoSave(ids, label, saveFn) {
      ids.forEach((id) => {
        $(id).addEventListener("change", async () => {
          try {
            await saveFn();
            showSavedPill();
          } catch (e) { logLine(label + " save failed: " + e.message, "e"); }
        });
      });
    }

    autoSave(
      ["setMaxAttempts", "setPoweroffLocked", "setAutoLock", "setUsbNoAutoLock"],
      "Security",
      () => flipper.setSecuritySettings(collectSecurityPayload())
    );
    // On Exceed gets its own listener rather than autoSave() - switching it
    // TO "Format SD" needs the same confirmation the old Apply-button flow
    // had (too many wrong PIN attempts will wipe the SD card), and a
    // cancel needs to revert the select rather than silently leaving it on
    // a value that was never actually saved.
    $("setOnExceed").addEventListener("change", async () => {
      if ($("setOnExceed").value === "1" &&
          !confirm('"On Exceed" is set to "Format SD" - too many wrong PIN attempts will wipe the SD card. Continue?')) {
        $("setOnExceed").value = lastOnExceedValue;
        return;
      }
      try {
        await flipper.setSecuritySettings(collectSecurityPayload());
        lastOnExceedValue = $("setOnExceed").value;
        showSavedPill();
      } catch (e) { logLine("Security save failed: " + e.message, "e"); }
    });
    autoSave(
      ["setOnLockEnabled", "setDisconnectBle", "setDisconnectGpio", "setUsbLevel"],
      "Advanced Security",
      () => flipper.setSecuritySettings(collectSecurityPayload())
    );
    autoSave(
      ["setLockShowTime", "setLockShowSeconds", "setLockShowDate", "setLockShowStatusbar", "setLockUnlockPrompt"],
      "Lock Screen Display",
      () => flipper.setSecuritySettings(collectSecurityPayload())
    );

    autoSave(["setTheme"], "Menu theme", () => flipper.setThemeSettings(Number($("setTheme").value)));

    autoSave(
      ["setContrast", "setBacklight", "setLed", "setVolume", "setDelay", "setVibro", "setInversion"],
      "Display & sound",
      () => flipper.setNotifSettings({
        contrast: Number($("setContrast").value),
        backlightPct: Number($("setBacklight").value),
        ledPct: Number($("setLed").value),
        volumePct: Number($("setVolume").value),
        delayMs: Number($("setDelay").value),
        vibro: $("setVibro").value === "1",
        inversion: $("setInversion").value === "1",
      })
    );

    // â”€â”€ Settings: task #75/#82 additions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    autoSave(
      ["setBatteryView", "setShowClock", "setMidnightFmt", "setWifiIcon", "setStatusbarIcons", "setShellColor"],
      "Desktop display",
      () => flipper.setDesktopSettings({
        batteryView: Number($("setBatteryView").value),
        showClock: $("setShowClock").value === "1",
        midnightFormat: $("setMidnightFmt").value === "1",
        wifiIconHidden: $("setWifiIcon").value === "1",
        statusbarIcons: $("setStatusbarIcons").value === "1",
        shellColorIdx: Number($("setShellColor").value),
      })
    );

    autoSave(
      ["setAlarmBacklight", "setAlarmBeep", "setAlarmVibrate"],
      "Fox Alarm",
      () => flipper.setAlarmSettings({
        alarmKeepBacklight: $("setAlarmBacklight").value === "1",
        alarmBeep: $("setAlarmBeep").value === "1",
        alarmVibrate: $("setAlarmVibrate").value === "1",
      })
    );

    autoSave(
      ["setRgbInstalled", "setRgbWhiteMode", "setRgbLed1", "setRgbLed2", "setRgbLed3",
       "setRgbEffect", "setRgbSpeed", "setRgbStep", "setRgbSaturation", "setRgbWaveWide"],
      "RGB backlight",
      () => flipper.setRgbSettings({
        rgbInstalled: $("setRgbInstalled").value === "1",
        rgbWhiteMode: $("setRgbWhiteMode").value === "1",
        rgbLed1: Number($("setRgbLed1").value),
        rgbLed2: Number($("setRgbLed2").value),
        rgbLed3: Number($("setRgbLed3").value),
        rgbEffect: Number($("setRgbEffect").value),
        rgbSpeedMs: Number($("setRgbSpeed").value),
        rgbStep: Number($("setRgbStep").value),
        rgbSaturation: Number($("setRgbSaturation").value),
        rgbWaveWide: Number($("setRgbWaveWide").value),
      })
    );

    autoSave(
      ["setAutoPoweroff", "setLimitCharge"],
      "Power",
      () => flipper.setPowerSettings({
        autoPoweroffIdx: Number($("setAutoPoweroff").value),
        limitChargeIdx: Number($("setLimitCharge").value),
      })
    );

    autoSave(["setBtEnabled"], "Bluetooth", () => flipper.setBtSettings($("setBtEnabled").value === "1"));

    autoSave(
      ["setTimeFmt", "setDateFmt", "setUnits", "setHand"],
      "Locale",
      () => flipper.setLocaleSettings({
        timeFormat: Number($("setTimeFmt").value),
        dateFormat: Number($("setDateFmt").value),
        units: Number($("setUnits").value),
        handOrient: Number($("setHand").value),
      })
    );

    // Sleep Method/File Naming auto-save through the same combined command
    // Device Name uses (see foxr_handle_settings_system_set()) - that's
    // fine here, since resending the current, unchanged Device Name value
    // never trips a restart on its own (see applyDeviceNameBtn's handler
    // below for the case that does).
    autoSave(
      ["setSleepMethod", "setFileNaming"],
      "System",
      () => flipper.setSystemSettings({
        sleepMethod: Number($("setSleepMethod").value),
        fileNaming: Number($("setFileNaming").value),
        deviceName: $("setDeviceName").value,
      })
    );

    autoSave(
      ["setVibroLevel", "setVibroTrigger"],
      "Notifications",
      () => flipper.setInputSettings({
        vibroLevelIdx: Number($("setVibroLevel").value),
        vibroTriggerIdx: Number($("setVibroTrigger").value),
      })
    );

    $("applyNightShiftBtn").addEventListener("click", async () => {
      try {
        const timeToMin = (t) => {
          const m = /^(\d{2}):(\d{2})$/.exec(t || "");
          return m ? Number(m[1]) * 60 + Number(m[2]) : 0;
        };
        await flipper.setNightShiftSettings({
          nightShiftIdx: Number($("setNightShift").value),
          nightShiftStartMin: timeToMin($("setNightShiftStart").value),
          nightShiftEndMin: timeToMin($("setNightShiftEnd").value),
        });
        logLine("Night Shift settings saved.", "ok");
      } catch (e) { logLine("Night Shift save failed: " + e.message, "e"); }
    });
    // Device Name lives in its own card (up top) but is saved via the same
    // combined FLPR/SETTINGS/SYSTEM/SET command as Sleep Method/File Naming
    // (see foxr_handle_settings_system_set()'s comment) - so this sends the
    // current value of all three either way. Unlike before, saving no
    // longer reboots the Flipper immediately (that would also power-cycle
    // the attached ESP32 and drop this very connection) - it only does
    // that if the name actually changed, and even then just remembers a
    // pending restart for when the FoxLAB app is closed on the Flipper
    // itself (see restart_confirm_view.c/app.h's device_name_restart_
    // pending), rather than doing it from here.
    $("applyDeviceNameBtn").addEventListener("click", async () => {
      try {
        const restartPending = await flipper.setSystemSettings({
          sleepMethod: Number($("setSleepMethod").value),
          fileNaming: Number($("setFileNaming").value),
          deviceName: $("setDeviceName").value,
        });
        if (restartPending) {
          alert("Device name will update on next reboot. A reminder has been set.");
          logLine("Device Name saved - restart reminder set.", "ok");
        } else {
          logLine("Device Name saved.", "ok");
        }
      } catch (e) { logLine("Device Name save failed: " + e.message, "e"); }
    });

    // â”€â”€ Fox Alarm Clock: individual alarm list (task #96) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    const ALARM_DAY_LABELS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    const ALARM_DAY_BITS = [1, 2, 4, 8, 16, 32, 64];
    let alarmEditIndex = null; // null while adding a new alarm; an existing alarm's index while editing one
    let alarmEditDaysMask = 0;
    const padTime = (n) => String(n).padStart(2, "0");
    function formatAlarmTime(hour, minute) { return padTime(hour) + ":" + padTime(minute); }
    function formatAlarmDays(daysMask, recurring) {
      if (!recurring) return "Once";
      if (daysMask === 127) return "Every day";
      const names = ALARM_DAY_BITS.map((bit, i) => (daysMask & bit) ? ALARM_DAY_LABELS[i] : null).filter(Boolean);
      return names.length ? names.join(", ") : "No days selected";
    }
    function updateAlarmDaysVisibility() {
      $("alarmEditDays").style.display = $("alarmEditRecurring").value === "1" ? "" : "none";
    }
    function renderAlarmDayChips() {
      const el = $("alarmEditDays");
      el.innerHTML = ALARM_DAY_LABELS.map((name, i) =>
        `<button type="button" class="bsm day-chip${(alarmEditDaysMask & ALARM_DAY_BITS[i]) ? " sel" : ""}" data-bit="${ALARM_DAY_BITS[i]}">${name}</button>`
      ).join("");
      el.querySelectorAll(".day-chip").forEach((btn) => {
        btn.addEventListener("click", () => {
          const bit = Number(btn.dataset.bit);
          alarmEditDaysMask ^= bit;
          btn.classList.toggle("sel", !!(alarmEditDaysMask & bit));
        });
      });
    }
    function openAlarmEditor(alarm) {
      alarmEditIndex = alarm ? alarm.index : null;
      alarmEditDaysMask = alarm ? alarm.daysMask : 0;
      $("alarmEditTime").value = alarm ? formatAlarmTime(alarm.hour, alarm.minute) : "07:00";
      $("alarmEditActive").value = alarm && !alarm.active ? "0" : "1";
      $("alarmEditRecurring").value = alarm && !alarm.recurring ? "0" : "1";
      renderAlarmDayChips();
      updateAlarmDaysVisibility();
      $("alarmEditSaveBtn").textContent = alarm ? "Save Changes" : "Add Alarm";
      $("alarmEditor").style.display = "";
    }
    function closeAlarmEditor() {
      $("alarmEditor").style.display = "none";
      alarmEditIndex = null;
    }
    async function renderAlarmList() {
      const listBody = $("alarmListBody");
      let alarms;
      try {
        alarms = await flipper.getAlarmList();
      } catch (e) {
        listBody.innerHTML = `<div class="empty">Couldn't read the alarm list: ${e.message}</div>`;
        return;
      }
      if (!alarms.length) {
        listBody.innerHTML = '<div class="empty">No alarms set yet.</div>';
        return;
      }
      listBody.innerHTML = alarms.map((a) => `
        <div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border)">
          <div style="font-family:var(--mono);font-size:1rem;color:${a.active ? "#fff" : "#666"}">${formatAlarmTime(a.hour, a.minute)}</div>
          <div style="flex:1;color:#999;font-size:.8rem">${formatAlarmDays(a.daysMask, a.recurring)}${a.active ? "" : " \u00b7 Off"}</div>
          <button class="bsm alarm-edit-btn" data-index="${a.index}">Edit</button>
          <button class="bsm alarm-delete-btn" data-index="${a.index}">Delete</button>
        </div>
      `).join("");
      listBody.querySelectorAll(".alarm-edit-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const a = alarms.find((x) => x.index === Number(btn.dataset.index));
          if (a) openAlarmEditor(a);
        });
      });
      listBody.querySelectorAll(".alarm-delete-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          if (!confirm("Delete this alarm?")) return;
          try {
            await flipper.deleteAlarm(Number(btn.dataset.index));
            logLine("Alarm deleted.", "ok");
            renderAlarmList();
          } catch (e) { logLine("Delete alarm failed: " + e.message, "e"); }
        });
      });
    }
    $("addAlarmBtn").addEventListener("click", () => openAlarmEditor(null));
    $("alarmEditCancelBtn").addEventListener("click", closeAlarmEditor);
    $("alarmEditRecurring").addEventListener("change", updateAlarmDaysVisibility);
    $("alarmEditSaveBtn").addEventListener("click", async () => {
      const m = /^(\d{2}):(\d{2})$/.exec($("alarmEditTime").value || "");
      if (!m) { logLine("Enter a valid alarm time.", "e"); return; }
      const recurring = $("alarmEditRecurring").value === "1";
      if (recurring && alarmEditDaysMask === 0) {
        logLine("Select at least one day, or set Repeat to \"Once\".", "e");
        return;
      }
      const payload = {
        hour: Number(m[1]), minute: Number(m[2]),
        daysMask: alarmEditDaysMask, active: $("alarmEditActive").value === "1", recurring,
      };
      try {
        if (alarmEditIndex === null) {
          await flipper.addAlarm(payload);
          logLine("Alarm added.", "ok");
        } else {
          await flipper.editAlarm(alarmEditIndex, payload);
          logLine("Alarm saved.", "ok");
        }
        closeAlarmEditor();
        renderAlarmList();
      } catch (e) {
        logLine("Save alarm failed: " + (e.message === "FULL" ? "Alarm list is full (8 max)." : e.message), "e");
      }
    });
    renderAlarmList();
  }

  // Hook the remaining Flipper section entries not already wired via
  // onEnterFlipperSection() above.
  const _origEnter = onEnterFlipperSection;
  onEnterFlipperSection = async function (section) {
    await _origEnter(section);
    if (section === "pulseplotter") ensurePlotterUi();
    if (section === "subghz") ensureSubghzViewerUi();
    if (section === "settings") await renderFlipperSettings();
    if (section === "libraries" && !librariesState.scanned) await scanLibraries();
  };

  // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• ESP32: command console builder â•â•â•â•â•â•â•â•â•â•â•â•â•â•

  function makeCmdConsole(containerId, commands, opts) {
    opts = opts || {};
    const el = $(containerId);
    let html = "";
    if (opts.gateNotice) {
      html += `<div class="notice warn show">Gated commands below need <code>SETTINGS:ATTACKS:ON</code> first (Settings tab) - they reply <code>ERROR:DISABLED</code> otherwise, and this firmware self-limits every burst to a few seconds.</div>`;
    }
    html += '<div class="cmd-grid">' + commands.map((c, i) =>
      `<button class="cmd-btn" data-idx="${i}" disabled>${c.label}</button>`
    ).join("") + "</div>";
    html += `<div class="cmd-out" id="${containerId}Out"></div>
      <div class="cmd-input-row">
        <input type="text" id="${containerId}RawInput" placeholder="Or type a raw commandâ€¦" autocomplete="off">
        <button class="bsm" id="${containerId}RawSend" disabled>Send</button>
      </div>`;
    el.innerHTML = html;
    const out = $(containerId + "Out");
    function print(line, cls) {
      const div = document.createElement("div");
      if (cls) div.style.color = cls;
      div.textContent = line;
      out.appendChild(div);
      out.scrollTop = out.scrollHeight;
    }
    el.querySelectorAll(".cmd-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        const cmd = commands[+btn.dataset.idx];
        let text = cmd.cmd;
        if (cmd.prompt) {
          const val = prompt(cmd.prompt);
          if (val === null) return;
          text = cmd.cmd + val;
        }
        print("> " + text);
        try {
          const off = esp32.onLine((line) => print(line, line.startsWith("ERROR") ? "#e88" : "#8e8"));
          await esp32.send(text);
          setTimeout(off, cmd.durationMs || 9000);
        } catch (e) { print("send failed: " + e.message, "#e88"); }
      });
    });
    const rawInput = $(containerId + "RawInput");
    const rawSend = $(containerId + "RawSend");
    const sendRaw = async () => {
      const text = rawInput.value;
      if (!text) return;
      print("> " + text);
      // Scoped listener, same as the preset buttons above - not a permanent
      // subscription, so typing into one panel's raw box doesn't also echo
      // into every other panel's output.
      const off = esp32.onLine((line) => print(line, line.startsWith("ERROR") ? "#e88" : "#8e8"));
      esp32.send(text).catch(e => print("send failed: " + e.message, "#e88"));
      setTimeout(off, 9000);
      rawInput.value = "";
    };
    rawSend.addEventListener("click", sendRaw);
    rawInput.addEventListener("keydown", (e) => { if (e.key === "Enter") sendRaw(); });
    return {
      setEnabled(enabled) {
        el.querySelectorAll(".cmd-btn, button, input").forEach(b => { b.disabled = !enabled; });
      },
    };
  }

  // â”€â”€ Terminal tab (ESP32) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  // Was "AI" (a Gemini relay) - dropped because the FoxLAB AP has no
  // internet passthrough for it to actually reach Gemini with (same reason
  // Showcase/FAP Compiler were removed entirely, for the same missing-
  // internet reason). gemini.cpp/gemini.h and the AIASK/AICOOLDOWN commands are left
  // in place on the ESP32 side - dead but harmless, same call this project
  // has made for other now-unreachable-from-the-UI features - only this
  // tab and its makeCmdConsole() entry are gone.
  //
  // In its place: a raw terminal into FoxDispatch::handleCommand(), styled
  // after lab.flipper.net's own CLI splash (block-letter banner + welcome
  // blurb + firmware line + prompt) - structurally similar on purpose, but
  // original content throughout: "FOXLAB" instead of "FLIPPER", and wording
  // that describes this firmware instead of theirs. An ASCII mascot sat
  // above the banner here originally but never looked right at terminal
  // width, so it's gone - user's call, removed rather than kept fiddling
  // with it.
  const TERM_FOXLAB_BANNER = [
    " _____ _____  ___        _    ____",
    "|  ___/ _ \\ \\/ / |      / \\  | __ )",
    "| |_ | | | \\  /| |     / _ \\ |  _ \\",
    "|  _|| |_| /  \\| |___ / ___ \\| |_) |",
    "|_|   \\___/_/\\_\\_____/_/   \\_\\____/",
  ].join("\n");

  function buildEsp32Terminal(containerId) {
    const el = $(containerId);
    el.innerHTML = `
      <div class="card" style="padding:0;overflow:hidden">
        <pre class="term-banner" id="${containerId}Banner"></pre>
      </div>
      <div class="cmd-out term-out" id="${containerId}Out"></div>
      <div class="cmd-input-row">
        <input type="text" id="${containerId}Input" placeholder="Type a commandâ€¦" autocomplete="off">
        <button class="bsm pri" id="${containerId}Send" disabled>Send</button>
      </div>`;
    const banner = $(containerId + "Banner");
    banner.textContent = TERM_FOXLAB_BANNER + "\n\n" +
      "Welcome to the FoxLAB Terminal.\n\n" +
      "This is a raw line into the Fox ESP32 Firmware's own command dispatcher\n" +
      "- the same one every tab above ultimately talks to. Anything it doesn't\n" +
      "recognize is just echoed back, so there's nothing here that typing the\n" +
      "wrong thing can break. Try \"info\" or \"[LIST]\" to see what it knows.\n\n" +
      "Firmware: queryingâ€¦";
    const out = $(containerId + "Out");
    function print(line, cls) {
      const div = document.createElement("div");
      if (cls) div.style.color = cls;
      div.textContent = line;
      out.appendChild(div);
      out.scrollTop = out.scrollHeight;
    }
    // Unlike makeCmdConsole()'s scoped, auto-unsubscribed-after-a-timeout
    // listeners, this one is permanent - a terminal should show everything
    // the ESP32 says for as long as the page is open, not just replies to
    // commands typed in this one box (other tabs' button presses show up
    // here too, same as a real serial monitor would show activity from any
    // source on the same UART).
    esp32.onLine((line) => print(line, line.startsWith("ERROR") ? "#e88" : "#8e8"));
    const input = $(containerId + "Input");
    const send = $(containerId + "Send");
    const sendCmd = () => {
      const text = input.value;
      if (!text) return;
      print("> " + text, "#ffb870");
      esp32.send(text).catch(e => print("send failed: " + e.message, "#e88"));
      input.value = "";
    };
    send.addEventListener("click", sendCmd);
    input.addEventListener("keydown", (e) => { if (e.key === "Enter") sendCmd(); });
    return {
      setEnabled(enabled) { input.disabled = !enabled; send.disabled = !enabled; },
      // Called once from onEsp32Connected() after a [VERSION] probe -
      // rewrites just the banner's placeholder "Firmware: â€¦" line in
      // place rather than reprinting the whole banner.
      setFirmwareLine(text) {
        banner.textContent = banner.textContent.replace(/Firmware: .*/, "Firmware: " + text);
      },
    };
  }

  const esp32Consoles = {};
  function buildEsp32Consoles() {
    esp32Consoles.wifi = makeCmdConsole("esp32WifiBody", [
      { label: "Scan APs", cmd: "WIFISCANAP" },
      { label: "Scan Stations", cmd: "WIFISCANSTA" },
      { label: "Scan All", cmd: "WIFISCANALL" },
      { label: "List cached APs", cmd: "WIFILIST:AP" },
      { label: "List cached STAs", cmd: "WIFILIST:STA" },
      { label: "Select APâ€¦", cmd: "WIFISELECT:AP:", prompt: "AP index:" },
      { label: "Select STAâ€¦", cmd: "WIFISELECT:STA:", prompt: "STA index:" },
      { label: "AP infoâ€¦", cmd: "WIFIAPINFO:", prompt: "AP index:" },
      { label: "Channel (read)", cmd: "WIFICHANNEL" },
      { label: "Set channelâ€¦", cmd: "WIFICHANNEL:", prompt: "Channel 1-14:" },
      { label: "Signal monitor (10s)", cmd: "WIFISIGMON", durationMs: 11000 },
      { label: "Packet count (5s)", cmd: "WIFIPACKETCOUNT", durationMs: 6000 },
      { label: "Sniff: Beacon", cmd: "WIFISNIFF:BEACON", durationMs: 9000 },
      { label: "Sniff: Deauth", cmd: "WIFISNIFF:DEAUTH", durationMs: 9000 },
      { label: "Sniff: Probe", cmd: "WIFISNIFF:PROBE", durationMs: 9000 },
      { label: "Sniff: Raw", cmd: "WIFISNIFF:RAW", durationMs: 9000 },
      { label: "Sniff: MultiSSID", cmd: "WIFISNIFF:MULTISSID", durationMs: 9000 },
      { label: "Sniff: PMKID", cmd: "WIFISNIFF:PMKID", durationMs: 9000 },
      { label: "Sniff: SAE", cmd: "WIFISNIFF:SAE", durationMs: 9000 },
      { label: "MAC: show", cmd: "WIFIMAC:GET" },
      { label: "MAC: randomize", cmd: "WIFIMAC:RAND" },
      { label: "MAC: clone AP", cmd: "WIFIMAC:CLONEAP" },
      { label: "MAC: reset", cmd: "WIFIMAC:RESET" },
      { label: "Wardrive (needs GPS)", cmd: "WIFIWARDRIVE", durationMs: 15000 },
      { label: "PCAP capture (15s)", cmd: "WIFIPCAP", durationMs: 16000 },
      { label: "Port scanâ€¦", cmd: "WIFIPORTSCAN:", prompt: "ip:start:end e.g. 192.168.1.1:1:100", durationMs: 15000 },
      { label: "Attack: Deauth (broadcast)", cmd: "WIFIATTACK:DEAUTH", durationMs: 6000 },
      { label: "Attack: Deauth stationâ€¦", cmd: "WIFIATTACK:DEAUTH:", prompt: "Station MAC:", durationMs: 6000 },
      { label: "Attack: Beacon spamâ€¦", cmd: "WIFIATTACK:BEACON:", prompt: "SSID list, comma-separated:", durationMs: 6000 },
      { label: "Attack: Probe flood", cmd: "WIFIATTACK:PROBE", durationMs: 6000 },
      { label: "Attack: Rickroll", cmd: "WIFIATTACK:RICKROLL", durationMs: 6000 },
      { label: "Attack: Bad packet", cmd: "WIFIATTACK:BADPACKET", durationMs: 6000 },
      { label: "Attack: CSA", cmd: "WIFIATTACK:CSA", durationMs: 6000 },
      { label: "Attack: Sleep", cmd: "WIFIATTACK:SLEEP", durationMs: 6000 },
    ], { gateNotice: true });

    esp32Consoles.ble = makeCmdConsole("esp32BleBody", [
      { label: "BLE init", cmd: "BLEINIT" },
      { label: "BLE scan", cmd: "BLESCAN", durationMs: 9000 },
      { label: "Connectâ€¦", cmd: "BLECONN:", prompt: "MAC address:" },
      { label: "Status", cmd: "BLESTATUS" },
      { label: "Disconnect", cmd: "BLEDISC" },
      { label: "Tag scan: Find My", cmd: "BLETAGSCAN:FINDMY", durationMs: 9000 },
      { label: "Tag scan: SmartTag", cmd: "BLETAGSCAN:SMARTTAG", durationMs: 9000 },
      { label: "Tag scan: Tile", cmd: "BLETAGSCAN:TILE", durationMs: 9000 },
      { label: "Tag scan: Flock", cmd: "BLETAGSCAN:FLOCK", durationMs: 9000 },
      { label: "Spam: iOS", cmd: "BLESPAM:IOS", durationMs: 9000 },
      { label: "Spam: Windows", cmd: "BLESPAM:WINDOWS", durationMs: 9000 },
      { label: "Spam: Samsung", cmd: "BLESPAM:SAMSUNG", durationMs: 9000 },
      { label: "Spam: Android", cmd: "BLESPAM:ANDROID", durationMs: 9000 },
      { label: "Spam: All", cmd: "BLESPAM:ALL", durationMs: 9000 },
    ], { gateNotice: true });

    esp32Consoles.gps = makeCmdConsole("esp32GpsBody", [
      { label: "GPS init", cmd: "GPSINIT" },
      { label: "Fix status", cmd: "GPS:FIX" },
      { label: "Satellites", cmd: "GPS:SAT" },
      { label: "Latitude", cmd: "GPS:LAT" },
      { label: "Longitude", cmd: "GPS:LON" },
      { label: "Altitude", cmd: "GPS:ALT" },
      { label: "Date/time", cmd: "GPS:DATE" },
      { label: "Track (30s)", cmd: "GPSTRACK", durationMs: 31000 },
      { label: "POI: start", cmd: "GPSPOI:START" },
      { label: "POI: markâ€¦", cmd: "GPSPOI:MARK:", prompt: "Label (optional):" },
      { label: "POI: end", cmd: "GPSPOI:END" },
    ]);

    esp32Consoles.ir = makeCmdConsole("esp32IrBody", [
      { label: "Sendâ€¦", cmd: "IRSEND:", prompt: "protocol:hex[:bits] e.g. NEC:0x00FF00FF" },
      { label: "Receive (10s)", cmd: "IRRECV", durationMs: 11000 },
      { label: "TV-B-Gone", cmd: "IRTVBGONE", durationMs: 8000 },
    ]);

    esp32Consoles.subghz = makeCmdConsole("esp32SubghzBody", [
      { label: "Init", cmd: "SUBGHZINIT" },
      { label: "Set frequencyâ€¦", cmd: "SUBGHZFREQ:", prompt: "MHz, 300-928:" },
      { label: "RX (10s)", cmd: "SUBGHZRX", durationMs: 11000 },
      { label: "TXâ€¦", cmd: "SUBGHZTX:", prompt: "Raw hex bytes:" },
    ]);

    esp32Consoles.rfid = makeCmdConsole("esp32RfidBody", [
      { label: "Init", cmd: "RFIDINIT" },
      { label: "Scan for tag", cmd: "RFIDSCAN" },
      { label: "Read blockâ€¦", cmd: "RFIDREAD:", prompt: "Block number:" },
      { label: "Write blockâ€¦", cmd: "RFIDWRITE:", prompt: "block:hexdata e.g. 4:00112233445566778899AABBCCDDEEFF" },
    ]);

    esp32Consoles.terminal = buildEsp32Terminal("esp32TerminalBody");

    const settingsBody = $("esp32SettingsBody");
    settingsBody.innerHTML = `
      <div class="card">
        <h3>WiFi/BLE Attacks</h3>
        <p style="color:#999;font-size:.85rem;margin-bottom:12px">WiFi/BLE attack and beacon-spam commands are refused with <code>ERROR:DISABLED</code> while this is off - this firmware self-limits every burst to a few seconds regardless.</p>
        <label class="switch-row">
          <span class="switch"><input type="checkbox" id="attacksToggle" disabled><span class="slider"></span></span>
          <span class="switch-label" id="attacksToggleLabel">Disabled</span>
        </label>
      </div>
      <div class="cmd-out" id="esp32SettingsOut"></div>`;
    const settingsOut = $("esp32SettingsOut");
    function printSettings(line) {
      const div = document.createElement("div");
      div.textContent = line;
      settingsOut.appendChild(div);
      settingsOut.scrollTop = settingsOut.scrollHeight;
    }
    function sendSetting(cmd) {
      printSettings("> " + cmd);
      const off = esp32.onLine(printSettings);
      esp32.send(cmd).catch(e => printSettings(e.message));
      setTimeout(off, 3000);
    }
    const attacksToggle = $("attacksToggle");
    const attacksToggleLabel = $("attacksToggleLabel");
    attacksToggle.addEventListener("change", () => {
      attacksToggleLabel.textContent = attacksToggle.checked ? "Enabled" : "Disabled";
      sendSetting(attacksToggle.checked ? "SETTINGS:ATTACKS:ON" : "SETTINGS:ATTACKS:OFF");
    });
    esp32Consoles.settingsToggle = {
      setEnabled(en) {
        attacksToggle.disabled = !en;
        // Firmware has no "am I armed?" query, only the fire-and-forget
        // ON/OFF commands below - so there's nothing to read state back
        // from on (re)connect, same as the two-button version this
        // replaced. Reset to the safe "Disabled" position rather than
        // guessing/remembering a state that may no longer be true.
        if (en) { attacksToggle.checked = false; attacksToggleLabel.textContent = "Disabled"; }
      },
    };
  }
  buildEsp32Consoles();

  function setEsp32ConsolesEnabled(enabled) {
    Object.values(esp32Consoles).forEach(c => c.setEnabled(enabled));
  }

  let lastEsp32Info = null;

  async function onEsp32Connected() {
    $("esp32Name").textContent = "ESP32 connected";
    $("esp32Sub").textContent = "Probing firmwareâ€¦";
    setEsp32ConsolesEnabled(true);
    const info = {};
    try {
      const lines = await esp32.sendAndCollect("info", (l) => l.includes("Fox ESP32 Firmware") || l.startsWith("ERROR"), 4000);
      const ok = lines.some(l => l.includes("Fox ESP32 Firmware"));
      $("esp32Sub").textContent = ok ? lines.join(" Â· ") : "Connected (unexpected response to 'info').";
    } catch (e) {
      $("esp32Sub").textContent = "Connected, but 'info' didn't respond: " + e.message;
    }
    // [VERSION] is the bracketed-protocol command http_bridge.cpp actually
    // answers with the version string (plain "info" above only confirms
    // the firmware is Fox_ESP32_FW at all, it doesn't say which build) -
    // feeds both the Terminal tab's banner and the Detailed View table
    // below.
    try {
      const verLines = await esp32.sendAndCollect("[VERSION]", (l) => l.startsWith("[VERSION/SUCCESS]"), 3000);
      const verLine = verLines.find(l => l.startsWith("[VERSION/SUCCESS]"));
      info["Firmware version"] = verLine ? verLine.slice("[VERSION/SUCCESS]".length) : "unknown";
    } catch (e) {
      info["Firmware version"] = "unknown";
    }
    esp32Consoles.terminal.setFirmwareLine(info["Firmware version"] === "unknown" ? "unknown" : "Fox ESP32 Firmware v" + info["Firmware version"]);
    try {
      const capLines = await esp32.sendAndCollect("CAPS", (l) => l.startsWith("HASBLE:"), 3000);
      const capLine = capLines.find(l => l.startsWith("HASBLE:"));
      info["Bluetooth (BLE)"] = capLine ? (capLine === "HASBLE:1" ? "Compiled in" : "Not compiled in") : "unknown";
    } catch (e) {
      info["Bluetooth (BLE)"] = "unknown";
    }
    // FOX_HAS_* flags aren't queryable directly for these four; each
    // optional-hardware family reports ERROR:NORFID/NOSUBGHZ/NOIR/NOGPS on
    // first use instead, so probe each with its init/no-op-ish command
    // rather than guessing. IR has no passive init-only command, so it's
    // probed with a real transmit - but not IRTVBGONE (real TV power-
    // toggle codes). Instead: IRSEND:NEC:00000000:32 - a full 32-bit NEC
    // frame where the address and command bytes are NOT complemented by
    // their upper 16 bits (NEC requires addr/~addr and cmd/~cmd; sending
    // 0x00000000 violates both). IRremoteESP8266's sender (what
    // Fox_ESP32_FW's IRSEND uses) transmits whatever bit pattern it's
    // given with no validation, so this still proves the IR LED/hardware
    // actually fires - but essentially every real NEC-protocol receiver
    // (TVs, ACs, etc.) checks that complement relationship before acting
    // and silently discards a frame that fails it, so no real device
    // treats this as a valid button press.
    const hwChecks = [
      { key: "RFID reader", cmd: "RFIDINIT", errTag: "NORFID" },
      { key: "SubGHz radio", cmd: "SUBGHZINIT", errTag: "NOSUBGHZ" },
      { key: "IR blaster", cmd: "IRSEND:NEC:00000000:32", errTag: "NOIR" },
      { key: "GPS module", cmd: "GPSINIT", errTag: "NOGPS" },
    ];
    for (const chk of hwChecks) {
      try {
        const lines = await esp32.sendAndCollect(chk.cmd, (l) => true, 3000);
        const enabled = !lines.some(l => l.includes(chk.errTag));
        info[chk.key] = enabled ? "Compiled in" : "Not compiled in";
      } catch (e) {
        info[chk.key] = "unknown";
      }
    }
    // Rolled into one always-visible table (below the hero, no button
    // gating it anymore - see #esp32HeroWrap's permanent "detail-open"
    // class) instead of a separate "Hardware" card - as a standing card,
    // four rows that are "Not compiled in" on most boards (RFID/SubGHz/IR/
    // GPS are all optional add-on hardware) took up permanent space to say
    // very little; folded in alongside firmware/BLE it reads as real
    // diagnostic info instead of a wall of "not compiled in".
    lastEsp32Info = info;
    $("esp32HeroDetailTable").innerHTML = Object.keys(lastEsp32Info).sort().map(k =>
      `<tr><td>${k}</td><td>${lastEsp32Info[k]}</td></tr>`).join("");
  }

  // â”€â”€ Back to top (visible only while the page actually has a scrollbar -
  // section switches change page height without a resize/scroll event, so
  // a MutationObserver catches those too) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  (function () {
    const btn = $("backTop");
    let raf = null;
    function check() {
      raf = null;
      btn.classList.toggle("show", document.documentElement.scrollHeight > document.documentElement.clientHeight + 4);
    }
    function scheduleCheck() { if (!raf) raf = requestAnimationFrame(check); }
    scheduleCheck();
    window.addEventListener("resize", scheduleCheck);
    window.addEventListener("scroll", scheduleCheck, { passive: true });
    new MutationObserver(scheduleCheck).observe(document.body, { childList: true, subtree: true });
    btn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
  })();

  // â”€â”€ Init â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  // Both clients are plain WebSockets to the ESP32 the browser is already
  // on WiFi with - loading this page at all means you're already "in", so
  // both connect automatically here rather than waiting for a button
  // click. They're independent: a Flipper that isn't ready yet (still
  // inside a Fox app, or just not attached) doesn't block the ESP32 tab
  // from working, and vice versa. Each call updates its own pill/status
  // notice on failure (see connectDevice() above) rather than throwing -
  // nothing here needs a try/catch of its own.
  connectDevice("esp32");
  connectDevice("flipper");
})();

</script>

</body>
</html>

