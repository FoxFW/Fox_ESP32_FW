              <option value="8">10</option>
            </select>
          </div>
          <div class="set-field">
            <span>On Exceed</span>
            <select id="setOnExceed"><option value="0">Lock only</option><option value="1">Format SD</option></select>
          </div>
          <div class="set-field">
